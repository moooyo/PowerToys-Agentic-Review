# Worker identity comes only from the exact canonical plaintext profile at
# C:\ProgramData\AgenticReview\Control\worker-auth-v1.json. Do not place the Token or workerNodeId
# in this environment file.

# Central Server endpoint and non-secret Worker metadata.
WORKER_SERVER_URL=https://workers.example.internal
WORKER_DISPLAY_NAME=PowerToys Worker 01
WORKER_VERSION=0.1.0
WORKER_PROTOCOL_VERSION=1.0

# Capacity and advertised capabilities.
WORKER_MAX_SLOTS=1
WORKER_EXECUTION_ENABLED=false
# WORKER_PROCESS_HOST_PATH is intentionally unset while execution is disabled.
WORKER_CODEX_VERSION=not-configured
WORKER_RECIPE_IDS=
WORKER_LABELS_JSON={"pool":"powertoys","region":"local"}

# Runtime storage and lease behavior.
WORKER_DATA_DIR=C:\ProgramData\AgenticReview\Worker
WORKER_CLAIM_WAIT_SECONDS=30
WORKER_HEARTBEAT_SECONDS=20
WORKER_HEARTBEAT_SAFETY_MARGIN_SECONDS=20
WORKER_SHUTDOWN_GRACE_SECONDS=90
WORKER_LOG_LEVEL=info

# Optional private Server CA. Worker client certificates and private keys are not used.
WORKER_TLS_CA_PATH=C:\ProgramData\AgenticReview\Worker\secrets\ca-cert.pem
# WORKER_TLS_SERVER_NAME=workers.example.internal
