<!--
  Dormant RoleConfig v2 package input. This file is not independently installable.
  The privileged installer must configure and verify the exact Executor virtual account,
  restricted service SID, service ACL, recovery policy, and protected filesystem roots.
-->
<service>
  <id>AgenticReview.Worker.Executor</id>
  <name>Agentic Review Worker Executor</name>
  <description>Hosts the zero-execution Agentic Review Worker Executor role.</description>

  <executable>C:\Program Files\AgenticReview\Worker\native\AgenticReview.ServiceHost.exe</executable>
  <arguments>--config=&quot;C:\ProgramData\AgenticReview\TrustedConfig\executor-service-host.json&quot;</arguments>
  <workingdirectory>C:\Program Files\AgenticReview\Worker</workingdirectory>

  <stoptimeout>330 sec</stoptimeout>

  <logpath>C:\ProgramData\AgenticReview\ServiceWrapper\Executor\Logs</logpath>
  <log mode="roll-by-size-time">
    <sizeThreshold>10485760</sizeThreshold>
    <pattern>yyyyMMdd</pattern>
    <autoRollAtTime>00:00:00</autoRollAtTime>
    <zipOlderThanNumDays>7</zipOlderThanNumDays>
    <keepFiles>14</keepFiles>
  </log>
</service>
