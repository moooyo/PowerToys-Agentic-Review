# Investigation Task / Report server. Values are process environment settings; no dotenv loader runs.
INVESTIGATION_HOST=127.0.0.1
INVESTIGATION_PORT=8000
INVESTIGATION_AUTH_MODE=loopback
INVESTIGATION_PUBLIC_ORIGIN=http://127.0.0.1:8000

# Use new, separate SQLite files. There is no migration, import, or compatibility conversion.
INVESTIGATION_DATABASE_PATH=/var/lib/agentic-review/investigation.sqlite
INVESTIGATION_AUTH_DATABASE_PATH=/var/lib/agentic-review/investigation-auth.sqlite
INVESTIGATION_DASHBOARD_DIRECTORY=/app/dashboard
INVESTIGATION_LOGIN_TTL_SECONDS=600
INVESTIGATION_SESSION_TTL_SECONDS=28800

# Explicit exact repository scopes and distinct operator permissions; wildcards are rejected.
# Loopback mode permits exactly one identity. No configured binding grants zero repository scope.
# INVESTIGATION_OPERATORS_JSON=[{"id":"local-operator","subject":"local-operator","displayName":"Local Operator","repositoryIds":["repo-powertoys-fork"],"permissions":["repository:manage","task:create","task:cancel","action:prepare","action:execute"],"actionCapabilities":["comment","approve","suggestion-comment","request-changes","close","merge","trigger-ci","close-as-duplicate","start-task","reviews.verify","view-validation","view-changes","create-pr","view-evidence","resume"],"allowRepositoryExecution":true}]
# A protected JSON file may be used instead of the inline JSON value.
# INVESTIGATION_OPERATORS_JSON_PATH=/run/secrets/investigation-operators.json

# OIDC deployment requires HTTPS, a concrete issuer, and explicit authorized operator subjects.
# INVESTIGATION_AUTH_MODE=oidc
# INVESTIGATION_PUBLIC_ORIGIN=https://review.example.com
# INVESTIGATION_OIDC_ISSUER_URL=https://identity.example.com/tenant
# INVESTIGATION_OIDC_CLIENT_ID=agentic-review
# INVESTIGATION_OIDC_CLIENT_SECRET_PATH=/run/secrets/investigation-oidc-client-secret
# Callback: https://review.example.com/api/auth/callback
# Inline alternative: INVESTIGATION_OIDC_CLIENT_SECRET; configure only one secret source.

# Bind to a non-loopback address only with TLS. Alternatively retain 127.0.0.1 behind an HTTPS proxy.
# The proxy must preserve the public Host header; its HTTP upstream must remain private.
# INVESTIGATION_HOST=0.0.0.0
# INVESTIGATION_TLS_KEY_PATH=/run/secrets/investigation-server.key
# INVESTIGATION_TLS_CERT_PATH=/run/secrets/investigation-server.crt
# INVESTIGATION_TLS_KEY_PASSPHRASE_PATH=/run/secrets/investigation-server-key-passphrase

# Worker credentials are required even in loopback mode. The default worker allowlist is empty.
# Create protected JSON containing [{"id":"worker-1","token":"<random-base64url-token>","repositoryIds":["repo-powertoys-fork"]}].
# Each token must come from at least 32 cryptographically random bytes and contain 43-256 base64url characters.
# INVESTIGATION_WORKERS_JSON_PATH=/run/secrets/investigation-workers.json
# An inline INVESTIGATION_WORKERS_JSON value is also supported; do not configure both forms.

# Optional GitHub transport. This expected account ID must match the authenticated GET /user result.
# Without credentials the application explicitly marks remote actions unavailable.
# INVESTIGATION_GITHUB_TOKEN_PATH=/run/secrets/investigation-github-token
# INVESTIGATION_GITHUB_USER_ID=12345678
# Inline alternative: INVESTIGATION_GITHUB_TOKEN; configure only one secret source.
# Writes also require exact, confirmed action intents. Test execution never grants live write approval.
INVESTIGATION_ENABLE_EXTERNAL_WRITES=false

# Complete read-only import budgets. Exhaustion rejects the import; it never truncates input.
INVESTIGATION_SOURCE_IMPORT_MAXIMUM_BYTES=16777216
INVESTIGATION_SOURCE_IMPORT_MAXIMUM_PAGES=1000
# Deployment-owned exact saved-plan/profile bindings, fixed operations, and prerequisite acknowledgements.
# Model-authored plan text never supplies executable paths or arguments. Missing bindings block execution.
# INVESTIGATION_EXECUTION_BINDINGS_PATH=/etc/agentic-review/investigation-execution-bindings.json
