# Production HTTPS listener. Worker routes authenticate with per-Worker bearer tokens.
NODE_ENV=production
AGENTIC_REVIEW_HOST=0.0.0.0
AGENTIC_REVIEW_PORT=8080
# Keep false during normal service. Recovery requires true plus a loopback-only host, configured
# operator authentication, no reverse-proxy upstream, and no published container port. Ordinary
# bridged-container recovery is unsupported; use a host process, host networking, or a same-network-
# namespace local tunnel sidecar.
AGENTIC_REVIEW_RECOVERY_MAINTENANCE=false
AGENTIC_REVIEW_TLS_KEY_PATH=/run/secrets/agentic-review-server.key
AGENTIC_REVIEW_TLS_CERT_PATH=/run/secrets/agentic-review-server.crt
# Optional when the server private key is encrypted.
# AGENTIC_REVIEW_TLS_KEY_PASSPHRASE=change-me

# Private SQLite database path.
AGENTIC_REVIEW_DATABASE_PATH=/var/lib/agentic-review/database/agentic-review.db
AGENTIC_REVIEW_MIGRATIONS_DIRECTORY=/app/migrations
# Private evidence bytes use a dedicated absolute directory outside the SQLite parent directory.
# The default is .evidence under the repository root; the filesystem root is never allowed.
# Keep this directory available in recovery maintenance for evidence reads. Uploads and cleanup
# remain disabled by the recovery application. These settings do not create scheduling authority.
AGENTIC_REVIEW_EVIDENCE_DIRECTORY=/var/lib/agentic-review/evidence
# Positive base-10 integers: bytes (maximum 1 TiB), assets (maximum 1000000), and milliseconds.
AGENTIC_REVIEW_EVIDENCE_GLOBAL_QUOTA_BYTES=10737418240
AGENTIC_REVIEW_EVIDENCE_GLOBAL_ASSET_LIMIT=10000
# Default retention is 7 days (maximum 365 days); incomplete uploads expire after 24 hours
# (maximum 7 days). Storage cleanup applies these limits when explicitly invoked.
AGENTIC_REVIEW_EVIDENCE_RETENTION_MS=604800000
AGENTIC_REVIEW_EVIDENCE_INCOMPLETE_UPLOAD_TTL_MS=86400000
AGENTIC_REVIEW_LOG_LEVEL=info
AGENTIC_REVIEW_HEARTBEAT_INTERVAL_SECONDS=20
AGENTIC_REVIEW_LEASE_TTL_SECONDS=120
AGENTIC_REVIEW_LEASE_REAPER_INTERVAL_SECONDS=15
AGENTIC_REVIEW_RETRY_DELAY_SECONDS=30
AGENTIC_REVIEW_WORKER_OFFLINE_AFTER_SECONDS=90
AGENTIC_REVIEW_MAX_LONG_POLL_SECONDS=30

# Same-origin React dashboard bundle. The production default is apps/dashboard/dist
# relative to the installed repository layout.
AGENTIC_REVIEW_DASHBOARD_DIRECTORY=/app/dashboard

# Operator authentication service. OIDC is optional; loopback mode requires
# loopback listener and loopback public origin.
AGENTIC_REVIEW_OPERATOR_AUTH_MODE=oidc
AGENTIC_REVIEW_PUBLIC_ORIGIN=https://agentic-review.example.com
AGENTIC_REVIEW_OIDC_ISSUER_URL=https://login.example.com/tenant/v2.0
AGENTIC_REVIEW_OIDC_CLIENT_ID=agentic-review
AGENTIC_REVIEW_OIDC_CLIENT_SECRET_PATH=/run/secrets/agentic-review-oidc-client-secret
AGENTIC_REVIEW_OIDC_CLIENT_AUTH_METHOD=client_secret_basic
AGENTIC_REVIEW_OIDC_SCOPES=openid profile email
AGENTIC_REVIEW_OIDC_AUTHORIZED_SUBJECTS_JSON=["operator-subject-id"]
# Required in OIDC mode: 1..1024 exact, unique subject IDs from AUTHORIZED_SUBJECTS_JSON.
# These identities are platform administrators for the exact configured issuer above.
# Login authorization alone grants no administrator role. Runtime administrators cannot be
# changed from the dashboard. Loopback mode uses only its explicit development identity.
AGENTIC_REVIEW_OIDC_ADMIN_SUBJECTS_JSON=["operator-subject-id"]
AGENTIC_REVIEW_OPERATOR_LOGIN_TTL_SECONDS=600
AGENTIC_REVIEW_OPERATOR_SESSION_TTL_SECONDS=28800
AGENTIC_REVIEW_OPERATOR_POST_LOGIN_PATH=/work-items
AGENTIC_REVIEW_OPERATOR_AUTH_CLEANUP_INTERVAL_SECONDS=900
AGENTIC_REVIEW_OPERATOR_AUTH_CLEANUP_BATCH_SIZE=500

# GitHub transport configuration. Configure either or both ingestion modes; a token or webhook
# secret does not require an environment repository list or a global reviewer. A new database has
# no repository scheduling authority until its reviewer and authorization policy are configured.
# Manage repositories, reviewers, authorization policies, and workflow prompt bindings in the
# dashboard. Polling remains the recovery path when repository webhook installation is unavailable.
AGENTIC_REVIEW_GITHUB_WEBHOOK_SECRET_PATH=/run/secrets/agentic-review-github-webhook-secret
AGENTIC_REVIEW_GITHUB_WEBHOOK_PATH=/api/v1/github/webhook
AGENTIC_REVIEW_GITHUB_WEBHOOK_MAX_BYTES=2097152
AGENTIC_REVIEW_GITHUB_TOKEN_PATH=/run/secrets/agentic-review-github-read-token
AGENTIC_REVIEW_GITHUB_POLL_INTERVAL_SECONDS=60

# GitHub publication is separate from ingestion and disabled by default. A repository policy
# and an explicit confirmation of the exact preview are also required. Use a dedicated
# fine-grained PAT or GitHub App user token; installation tokens are not supported here.
# The configured numeric account identity must match GET /user before delivery.
# Automated test permission never authorizes writes to a real repository PR or Issue.
AGENTIC_REVIEW_PUBLICATION_ENABLED=false
# AGENTIC_REVIEW_PUBLICATION_TOKEN_PATH=/run/secrets/agentic-review-github-publication-token
# AGENTIC_REVIEW_PUBLICATION_GITHUB_USER_ID=12345678

# Trusted file templates provide startup defaults independently of the optional legacy repository
# bootstrap. Published prompt versions and workflow bindings are managed in the database.
AGENTIC_REVIEW_PROMPT_DIRECTORY=/app/config/prompts

# Optional one-time bootstrap for an existing environment-configured deployment. Leave every
# setting below unset for a fresh database-managed deployment. If any bootstrap setting is supplied,
# REPOSITORIES_JSON, TARGET_USER_ID, and TARGET_LOGIN must all be present and non-empty; partial
# configuration fails startup, including an orphaned actor allowlist or policy setting.
# Numeric IDs are authorization keys; login and owner/name are display and API lookup snapshots.
# These values seed database configuration; they are not ongoing global authorization defaults.
# A complete bootstrap may seed metadata without transport credentials, but ingestion stays disabled
# until at least one transport is configured. Update managed configuration in the dashboard afterward.
# AGENTIC_REVIEW_GITHUB_REPOSITORIES_JSON=[{"githubRepositoryId":1844564,"fullName":"microsoft/PowerToys"}]
# AGENTIC_REVIEW_GITHUB_TARGET_USER_ID=12345678
# AGENTIC_REVIEW_GITHUB_TARGET_LOGIN=reviewer-login
# AGENTIC_REVIEW_GITHUB_ALLOWED_ACTOR_IDS_JSON=[23456789]
# AGENTIC_REVIEW_GITHUB_POLICY_VERSION=1
# New pull request revisions require a new authorized request by default. Selecting
# inherit_authorized_epoch explicitly trusts future PR code while that request remains active.
# Issue snapshots continue to inherit an active request because issue triage has no checkout.
# AGENTIC_REVIEW_GITHUB_NEW_REVISION_POLICY=require_new_authorization

# Loopback HTTP operator mode. Worker bearer-token authentication remains mandatory.
# AGENTIC_REVIEW_HOST=127.0.0.1
# AGENTIC_REVIEW_ALLOW_INSECURE_HTTP=true
# AGENTIC_REVIEW_OPERATOR_AUTH_MODE=loopback
# AGENTIC_REVIEW_PUBLIC_ORIGIN=http://127.0.0.1:8080
# AGENTIC_REVIEW_DEVELOPMENT_OPERATOR_SUBJECT=local-developer
# AGENTIC_REVIEW_RECOVERY_MAINTENANCE=true
