# Investigation Task / Report server. These are process environment settings; no dotenv loader runs.
INVESTIGATION_HOST=127.0.0.1
INVESTIGATION_PORT=8000
INVESTIGATION_AUTH_MODE=password
INVESTIGATION_PUBLIC_ORIGIN=http://127.0.0.1:8000

# New, separate SQLite files. Password accounts do not reuse or migrate the earlier auth schema.
# Restrict both database directories to the trusted service account and administrators.
# Investigation storage uses investigation-v3; exact v2 databases receive an additive history migration.
INVESTIGATION_DATABASE_PATH=/var/lib/agentic-review/investigation.sqlite
INVESTIGATION_AUTH_DATABASE_PATH=/var/lib/agentic-review/investigation-accounts.sqlite
INVESTIGATION_DASHBOARD_DIRECTORY=/app/dashboard
INVESTIGATION_SESSION_TTL_SECONDS=28800

# Required only for an empty account database; no predefined password or public registration exists.
# Create a protected UTF-8 file with exactly the intended 15-128 character password.
# The file is read verbatim, including any leading/trailing whitespace or final newline.
# An administrator starts with no implicit repository or execution permissions.
# INVESTIGATION_BOOTSTRAP_ADMIN_USERNAME=choose-an-admin-name
# INVESTIGATION_BOOTSTRAP_ADMIN_PASSWORD_PATH=/run/secrets/investigation-bootstrap-password
# INVESTIGATION_BOOTSTRAP_ADMIN_DISPLAY_NAME=Administrator
# Inline alternative: INVESTIGATION_BOOTSTRAP_ADMIN_PASSWORD; never configure both forms.
# Remove all bootstrap settings after initialization. Existing accounts are never overwritten.

# Async scrypt N=32768,r=8,p=3 with 32 MiB working memory and a 64 MiB per-call ceiling.
INVESTIGATION_PASSWORD_KDF_CONCURRENCY=2
INVESTIGATION_PASSWORD_KDF_QUEUE_LIMIT=8
# Shared limits also protect personal changes, account creation, and administrator resets.
INVESTIGATION_LOGIN_IP_LIMIT=30
INVESTIGATION_LOGIN_ACCOUNT_LIMIT=10
INVESTIGATION_LOGIN_WINDOW_SECONDS=900

# Remote browser access requires HTTPS. No passwordless local mode or OIDC callback is available.
# INVESTIGATION_PUBLIC_ORIGIN=https://review.example.com
# A non-loopback listener requires direct TLS; alternatively keep a private loopback HTTPS proxy.
# The proxy must preserve the public Host header; its upstream must remain private.
# Forwarded headers do not create identities or override rate-limit IP keys.
# INVESTIGATION_HOST=0.0.0.0
# INVESTIGATION_TLS_KEY_PATH=/run/secrets/investigation-server.key
# INVESTIGATION_TLS_CERT_PATH=/run/secrets/investigation-server.crt
# INVESTIGATION_TLS_KEY_PASSPHRASE_PATH=/run/secrets/investigation-server-key-passphrase

# Browser accounts never substitute for Worker credentials. The default Worker allowlist is empty.
# Protected JSON: [{"id":"worker-1","token":"<random-base64url-token>","repositoryIds":["repo-powertoys-fork"]}].
# Tokens must come from at least 32 cryptographically random bytes and contain 43-256 base64url characters.
# INVESTIGATION_WORKERS_JSON_PATH=/run/secrets/investigation-workers.json
# Inline INVESTIGATION_WORKERS_JSON is also supported; configure only one source.

# Optional GitHub transport, separate from account authentication.
# INVESTIGATION_GITHUB_TOKEN_PATH=/run/secrets/investigation-github-token
# INVESTIGATION_GITHUB_USER_ID=12345678
# Inline alternative: INVESTIGATION_GITHUB_TOKEN; configure only one token source.
# Writes require exact confirmed action intents; account administration never grants live test approval.
INVESTIGATION_ENABLE_EXTERNAL_WRITES=false

# Assignment Webhook receiver. Use a random secret of at least 32 UTF-8 bytes.
# Subscribe to GitHub Issues and Pull requests events with application/json payloads.
# Receiver URL: <public-origin>/api/github/webhook. Repository settings select watched repositories,
# recipient GitHub user IDs, and trusted assigning user IDs. No GitHub polling is started.
# INVESTIGATION_GITHUB_WEBHOOK_SECRET_PATH=/run/secrets/investigation-github-webhook-secret
# Inline alternative: INVESTIGATION_GITHUB_WEBHOOK_SECRET; configure only one source.
INVESTIGATION_GITHUB_WEBHOOK_MAXIMUM_BYTES=2097152
# Optional initial defaults; saved Dashboard settings override each repository's entry.
# INVESTIGATION_GITHUB_WEBHOOK_BINDINGS_JSON=[{"repositoryId":"repo-example","reviewerUserId":12345678,"allowedActorUserIds":[23456789]}]
# INVESTIGATION_GITHUB_WEBHOOK_BINDINGS_JSON_PATH=/etc/agentic-review/webhook-bindings.json

# Complete read-only import budgets. Exhaustion rejects the import; it never truncates input.
INVESTIGATION_SOURCE_IMPORT_MAXIMUM_BYTES=16777216
INVESTIGATION_SOURCE_IMPORT_MAXIMUM_PAGES=1000

# Resident artifact content quotas and retention. All settings are positive integers.
# Bytes count original content, not Base64/SQLite/WAL overhead or immutable report/metadata records.
# Cleanup preserves active tasks, recovery checkpoints, and pinned follow-up sources.
# Logical quota release does not guarantee that physical SQLite or WAL files shrink.
INVESTIGATION_EVIDENCE_MAXIMUM_BYTES=1073741824
INVESTIGATION_EVIDENCE_MAXIMUM_COUNT=10000
INVESTIGATION_EVIDENCE_RETENTION_SECONDS=2592000
INVESTIGATION_EVIDENCE_CLEANUP_INTERVAL_SECONDS=60
INVESTIGATION_EVIDENCE_CLEANUP_BATCH_SIZE=100

# Deployment-owned exact saved-plan/profile bindings, fixed operations, and prerequisite acknowledgements.
# Model-authored plan text never supplies executable paths or arguments. Missing bindings block execution.
# INVESTIGATION_EXECUTION_BINDINGS_PATH=/etc/agentic-review/investigation-execution-bindings.json
