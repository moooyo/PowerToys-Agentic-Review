{
  "name": "@agentic-review/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "prebuild": "node ./scripts/clean-build-output.mjs",
    "build": "tsc -b",
    "clean": "node ./scripts/clean-build-output.mjs",
    "dev": "node --enable-source-maps dist/main.js",
    "start": "node --enable-source-maps dist/main.js",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentic-review/codex": "workspace:*",
    "@agentic-review/contracts": "workspace:*",
    "@agentic-review/domain": "workspace:*",
    "@fastify/cookie": "11.1.2",
    "@fastify/rate-limit": "11.2.0",
    "@fastify/static": "10.1.3",
    "@sinclair/typebox": "0.34.52",
    "fastify": "5.12.1",
    "jsonc-parser": "3.3.1",
    "openid-client": "6.8.7"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
