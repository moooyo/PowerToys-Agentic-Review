{
  "name": "@agentic-review/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "prepare:workspace-dependencies": "pnpm --filter @agentic-review/codex build && pnpm --filter @agentic-review/contracts build",
    "prebuild": "pnpm run prepare:workspace-dependencies",
    "build": "node scripts/build-worker-bundles.mjs",
    "start": "node --enable-source-maps dist/worker.mjs",
    "pretest": "pnpm run prepare:workspace-dependencies",
    "test": "vitest run src",
    "pretypecheck": "pnpm run prepare:workspace-dependencies",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentic-review/codex": "workspace:*",
    "@agentic-review/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
