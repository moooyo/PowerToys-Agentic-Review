{
  "name": "@agentic-review/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.20.0 <25"
  },
  "scripts": {
    "prepare:workspace-dependencies": "pnpm --workspace-root run build:shared",
    "build": "pnpm run prepare:workspace-dependencies && pnpm run build:only",
    "build:only": "node scripts/build-worker-bundles.mjs",
    "start": "node --enable-source-maps dist/worker.mjs",
    "test": "pnpm run prepare:workspace-dependencies && pnpm run test:only",
    "test:only": "vitest run src",
    "typecheck": "pnpm run prepare:workspace-dependencies && pnpm run typecheck:only",
    "typecheck:only": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@agentic-review/codex": "workspace:*",
    "@agentic-review/contracts": "workspace:*",
    "@agentic-review/domain": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "playwright-core": "1.63.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "esbuild": "0.28.2",
    "typescript": "7.0.2"
  }
}
