{
  "name": "@agentic-review/dashboard",
  "version": "0.1.0",
  "private": true,
  "description": "Agentic Review operations dashboard",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 8000 --strictPort",
    "prepare:workspace-dependencies": "pnpm --filter @agentic-review/contracts build",
    "build": "pnpm run prepare:workspace-dependencies && pnpm run build:only",
    "build:only": "vite build",
    "preview": "vite preview --host 127.0.0.1 --port 8000 --strictPort",
    "test": "pnpm run prepare:workspace-dependencies && pnpm run test:only",
    "test:only": "vitest run src",
    "typecheck": "pnpm run prepare:workspace-dependencies && pnpm run typecheck:only",
    "typecheck:only": "tsc --noEmit"
  },
  "dependencies": {
    "@agentic-review/contracts": "workspace:*",
    "@sinclair/typebox": "0.34.52",
    "@tanstack/react-query": "5.102.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@mui/material": "9.4.0",
    "@mui/icons-material": "9.4.0",
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "react-router-dom": "7.18.3",
    "react-hook-form": "7.87.0",
    "@fontsource/roboto": "5.3.0",
    "@fontsource/roboto-mono": "5.3.0"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "typescript": "7.0.2",
    "vite": "8.2.2",
    "@vitejs/plugin-react": "6.1.1"
  }
}
