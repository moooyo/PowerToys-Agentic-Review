{
  "$schema": "https://biomejs.dev/schemas/2.5.11/schema.json",
  "files": {
    "includes": [
      "**",
      "!!**/node_modules",
      "!!**/dist",
      "!!**/.umi",
      "!!**/.umi-production",
      "!!**/coverage",
      "!!apps/dashboard/src/services/generated"
    ]
  },
  "formatter": {
    "enabled": true,
    "includes": [
      "**",
      "!!native/service-host/internal/localrpc/testdata/runtime_bootstrap_v1.json"
    ],
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  }
}
