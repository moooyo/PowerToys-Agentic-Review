{
  "name": "@agentic-review/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "node ./scripts/clean-build-output.mjs && pnpm run build:only",
    "build:only": "tsc -p tsconfig.json",
    "clean": "node ./scripts/clean-build-output.mjs && tsc -b --clean",
    "test": "pnpm run test:only",
    "test:only": "vitest run",
    "typecheck": "pnpm run typecheck:only",
    "typecheck:only": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@sinclair/typebox": "0.34.52"
  },
  "devDependencies": {
    "vitest": "4.1.11"
  }
}
