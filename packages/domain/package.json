{
  "name": "@agentic-review/domain",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm --filter @agentic-review/contracts build && pnpm run build:only",
    "build:only": "tsc -p tsconfig.json",
    "clean": "tsc -b --clean",
    "typecheck": "pnpm --filter @agentic-review/contracts build && pnpm run typecheck:only",
    "typecheck:only": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm --filter @agentic-review/contracts build && pnpm run test:only",
    "test:only": "vitest run"
  },
  "dependencies": {
    "@agentic-review/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "24.13.3",
    "vitest": "4.1.11"
  }
}
