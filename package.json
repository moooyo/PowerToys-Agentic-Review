{
  "name": "powertoys-agentic-review",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": ">=24.20.0 <25",
    "pnpm": ">=11.24.0 <12"
  },
  "scripts": {
    "build": "pnpm -r --if-present build",
    "dev": "pnpm --filter @agentic-review/server build && pnpm --parallel --filter @agentic-review/server --filter @agentic-review/dashboard dev",
    "format": "biome format --write .",
    "lint": "biome check .",
    "test": "pnpm -r --if-present test",
    "typecheck": "pnpm --filter @agentic-review/contracts build && pnpm --filter @agentic-review/domain build && pnpm --filter @agentic-review/codex build && pnpm -r --if-present typecheck"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.11",
    "@types/node": "24.13.3",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
